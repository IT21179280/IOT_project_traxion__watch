# Dashboard configuration
# Copy this file to ".env" and change the values, or set them as environment
# variables before running "npm start".

# MQTT broker that the dashboard subscribes to
MQTT_BROKER_URL=mqtt://192.168.1.3

# Topic that carries the watch telemetry (JSON payload)
MQTT_TOPIC=patient/data

# HTTP port of the dashboard
PORT=3000

# Fall alert email (Gmail). Use an App Password, not your normal password.
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your-app-password
ALERT_TO=caretaker@example.com
